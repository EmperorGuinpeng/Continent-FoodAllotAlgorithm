def rank(): #bubble sort
    
    for i in range(len(cuf)):
       for j in range(len(cuf)-1):
          if cuf[rk[j]]<cuf[rk[j+1]]:
             rk[j], rk[j+1] = rk[j+1], rk[j]
             

def Fac(ctn):
   rank()
   a = cuf[rk[0]]
   if a >= 2*facamount+pp[ctn]*k:
         cuf[rk[0]] -= 2*facamount
         cuf[rk[3]] += facamount
         cuf[rk[4]] += facamount
         #for i in range(3,5):
         #   cuf[rk[i]] += facamount

def turn(ctn):
    global year
    global world
    b=0
    while year < 100:
        l=u
        
        if tmp==1:
           l *= 1-year*earth[ctn]/1000
        if ifbee==1:
           b= 1-year/100
           if b<0.2:
              b=0.2
           l *=b
        for ctn in range(0,5):
         cuf[ctn]+= fp[ctn]*l
       #    print(currentfood[ctn])
         if cuf[ctn] >= pp[ctn]*k*100000000:
             world=world+'0'
             cuf[ctn]= cuf[ctn]-pp[ctn]*k*100000000
             rank()
             
         else:
            world=world+'1'
            rank()
            #help.append('{},{}서 {}로 {}'.format(year, ct[rk[0]], ct[ctn], pp[ctn]*k))
            cuf[rk[0]]-= pp[ctn]*k
            cuf[ctn]=0
         #print("*-*-*-*-")
         log.append(str(cuf))
         print('year {}'.format(year))
         #print(ct[ctn])
         #print(cuf)
         print(world)
         print(rk)
         #pp[ctn]=round(pp[ctn]*101/100)
         #print(pp[ctn])
         
        year+=1
        logg.append(world)
        if fac==1:
           Fac(ctn)
           log.append('FAC'+str(cuf))
        world=''
        if cuf[0]+cuf[1]+cuf[2]+cuf[3]+cuf[4] <= 0:
           break
        
    

